---
// Home (/). Thin route shell: owns SEO and composes the Paper Pixel portfolio dashboard from small,
// reusable Home sections. DOM order is also the required mobile reading order.
import Experience from "@components/Sections/Home/Experience.astro";
import FeaturedProjects from "@components/Sections/Home/FeaturedProjects.astro";
import Hero from "@components/Sections/Home/Hero.astro";
import LatestPosts from "@components/Sections/Home/LatestPosts.astro";
import PlayerProfile from "@components/Sections/Home/PlayerProfile.astro";
import siteData from "@config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <div class="site-container flex flex-col gap-12 py-8 md:gap-14 md:py-12">
    <div class="grid items-stretch gap-6 lg:grid-cols-[minmax(0,1.65fr)_minmax(280px,0.85fr)]">
      <Hero />
      <PlayerProfile />
    </div>

    <FeaturedProjects />

    <div class="grid items-start gap-12 lg:grid-cols-[minmax(280px,0.7fr)_minmax(0,1.3fr)]">
      <Experience />
      <LatestPosts />
    </div>
  </div>
</BaseLayout>
