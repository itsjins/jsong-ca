---
// Homepage project preview. The requested entries are explicit placeholders in typed homeData, not
// the template's demo project collection, so the homepage never misattributes demo work to Jin.
// This card shape can later be fed by collection entries without changing the section layout.
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import { PixelIcon } from "@components/svg/pixel-icons";
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Reveal } from "@components/ui/reveal";
import homeData from "@config/homeData.json";
---

<Reveal as="section" aria-labelledby="project-log-heading" class="flex flex-col gap-6">
  <SectionHeading id="project-log-heading" title="Project Log" />

  <ul class="grid gap-5 md:grid-cols-3">
    {
      homeData.featuredProjects.map((project, index) => (
        <li>
          <PixelPanel as="article" class="flex h-full flex-col gap-5 p-5 sm:p-6">
            <div class="flex items-center justify-between gap-3">
              <Badge pixel variant="muted">
                Placeholder
              </Badge>
              <span class="text-muted-foreground font-mono text-xs">
                PRJ.{String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <div class="flex flex-col gap-3">
              <h3 class="font-display text-foreground text-xs leading-relaxed uppercase">
                {project.title}
              </h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{project.stack}</p>
            </div>
          </PixelPanel>
        </li>
      ))
    }
  </ul>

  <a
    href="/projects/"
    class="primary-focus text-info hover:text-success inline-flex w-fit items-center gap-2 text-sm font-semibold transition-colors"
  >
    View all projects
    <PixelIcon name="arrow-right" class="size-4" />
  </a>
</Reveal>
