---
// Primary homepage introduction. Identity and action configuration come from typed homeData so the
// same facts can feed future pages without duplicating personal copy in markup.
import { PixelIcon } from "@components/svg/pixel-icons";
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";
import homeData from "@config/homeData.json";

const { name, role, focus, location, intro, resumeHref } = homeData.identity;
---

<PixelPanel
  as="section"
  elevated
  aria-labelledby="hero-heading"
  class="flex min-h-full flex-col items-start gap-5 p-6 sm:p-8 lg:p-10"
>
  <Badge pixel variant="info">Profile // 001</Badge>

  <div class="flex flex-col gap-3">
    <h1
      id="hero-heading"
      class="font-display text-info text-2xl leading-tight tracking-[-0.03em] uppercase sm:text-3xl lg:text-[2.5rem] lg:leading-[1.3]"
    >
      {name}
    </h1>
    <p class="text-foreground text-2xl leading-tight font-semibold sm:text-3xl">{role}</p>
  </div>

  <div class="flex max-w-3xl flex-col gap-3">
    <p class="text-info text-base font-semibold sm:text-lg">{focus}</p>
    <p class="text-muted-foreground flex items-start gap-2 text-sm sm:text-base">
      <PixelIcon name="globe" class="text-info mt-0.5 size-5 shrink-0" />
      <span>Based in {location}</span>
    </p>
  </div>

  <p class="text-muted-foreground max-w-2xl text-lg leading-relaxed sm:text-xl">{intro}</p>

  <div class="mt-auto flex w-full flex-col gap-4 pt-2 sm:w-auto sm:flex-row">
    <a
      href="/projects/"
      class="pixel-btn pixel-btn--blue min-h-12 px-5 py-3 text-center text-[10px] uppercase sm:text-xs"
    >
      View Projects
    </a>
    {
      resumeHref ? (
        <a
          href={resumeHref}
          class="pixel-btn min-h-12 px-5 py-3 text-center text-[10px] uppercase sm:text-xs"
        >
          Resume
        </a>
      ) : (
        <button
          type="button"
          disabled
          title="Resume link not configured"
          class="pixel-btn min-h-12 cursor-not-allowed px-5 py-3 text-[10px] uppercase opacity-55 sm:text-xs"
        >
          Resume
        </button>
      )
    }
  </div>
</PixelPanel>
