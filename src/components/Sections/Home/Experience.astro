---
// Compact professional-experience preview. Structured config makes this easy to expand or move to
// a dedicated collection later without duplicating facts between Home and Experience.
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import { Badge } from "@components/ui/badge";
import { PixelPanel } from "@components/ui/pixel-panel";
import { Reveal } from "@components/ui/reveal";
import homeData from "@config/homeData.json";
---

<Reveal
  as="section"
  id="experience"
  aria-labelledby="experience-heading"
  class="flex scroll-mt-24 flex-col gap-6"
>
  <SectionHeading id="experience-heading" title="Experience" />

  <ol class="flex flex-col gap-5">
    {
      homeData.experience.map((entry) => (
        <li>
          <PixelPanel as="article" class="flex flex-col gap-4 p-5 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <Badge pixel variant="success">
                Current
              </Badge>
              <time class="text-muted-foreground font-mono text-sm">{entry.period}</time>
            </div>
            <div class="flex flex-col gap-1">
              <h3 class="text-foreground text-xl font-semibold">{entry.organization}</h3>
              <p class="text-muted-foreground text-base">{entry.role}</p>
            </div>
          </PixelPanel>
        </li>
      ))
    }
  </ol>
</Reveal>
