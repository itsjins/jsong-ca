---
// Compact RPG-inspired status panel. It intentionally contains no invented metrics or skill levels;
// all values are supplied facts or user-requested status copy from typed homeData.
import { PixelPanel } from "@components/ui/pixel-panel";
import homeData from "@config/homeData.json";

const { role, profileFocus, location } = homeData.identity;
const fields = [
  { label: "Role", value: role },
  { label: "Focus", value: profileFocus },
  { label: "Location", value: location },
];
---

<PixelPanel
  as="aside"
  aria-labelledby="player-profile-heading"
  class="flex min-h-full flex-col p-5 sm:p-6"
>
  <div class="border-border mb-1 flex items-center justify-between gap-4 border-b-2 pb-4">
    <h2 id="player-profile-heading" class="font-display text-info text-xs uppercase">
      Player Profile
    </h2>
    <span class="text-muted-foreground font-mono text-xs">SYS.INFO</span>
  </div>

  <dl class="divide-border flex flex-1 flex-col divide-y">
    {
      fields.map((field) => (
        <div class="flex flex-col gap-1 py-4">
          <dt class="font-display text-secondary-700 dark:text-secondary text-[9px] uppercase">
            {field.label}
          </dt>
          <dd class="text-foreground text-base font-semibold">{field.value}</dd>
        </div>
      ))
    }
    <div class="flex flex-col gap-1 pt-4">
      <dt class="font-display text-secondary-700 dark:text-secondary text-[9px] uppercase">
        Status
      </dt>
      <dd class="text-foreground flex items-center gap-2 text-base font-semibold">
        <span class="bg-success size-2.5 shrink-0" aria-hidden="true"></span>
        {homeData.status}
      </dd>
    </div>
  </dl>
</PixelPanel>
