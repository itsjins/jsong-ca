---
// Two newest published entries from the existing blog collection, presented publicly as Notes.
// Draft filtering, ordering, destinations, and card mapping remain shared with the full listing.
import ContentCard from "@components/Cards/ContentCard.astro";
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import { PixelIcon } from "@components/svg/pixel-icons";
import { Reveal } from "@components/ui/reveal";
import { getSortedPosts } from "@js/blogData";
import { toPostCard } from "@js/postCards";

const notes = (await getSortedPosts()).slice(0, 2).map(toPostCard);
---

<Reveal
  as="section"
  id="notes"
  aria-labelledby="recent-notes-heading"
  class="flex scroll-mt-24 flex-col gap-6"
>
  <SectionHeading id="recent-notes-heading" title="Recent Notes" />

  {
    notes.length > 0 ? (
      <ul class="grid gap-5 sm:grid-cols-2">
        {notes.map((note) => (
          <li>
            <ContentCard {...note} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted-foreground text-base">No notes published yet.</p>
    )
  }

  <a
    href="/blog/"
    class="primary-focus text-info hover:text-success inline-flex w-fit items-center gap-2 text-sm font-semibold transition-colors"
  >
    View all Notes
    <PixelIcon name="arrow-right" class="size-4" />
  </a>
</Reveal>
