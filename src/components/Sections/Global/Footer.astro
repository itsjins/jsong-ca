---
// src/components/Sections/Global/Footer.astro — the global Paper Pixel site footer.
//
// Cross-page chrome, rendered once in BaseLayout below <main>. A full-bleed paper bar with a forest
// pixel seam holds identity, professional links, and the existing legal routes. It stacks to a
// centred column below `md`. Semantic tokens keep both Paper Pixel color modes coherent.
//
// Reuses what's here — the pixel-icon registry (`svg/pixel-icons`) for the four social glyphs, and
// `.site-container` / `.primary-focus` from global.css. No new primitives beyond that registry, no JS.
// GitHub/LinkedIn continue to resolve through socialData; while sameAs is empty they intentionally
// point at platform home pages rather than invented profiles. Email uses the configured placeholder.
import { PixelIcon, type PixelIconName } from "@components/svg/pixel-icons";
import siteData from "@config/siteData.json";
import { socialLink } from "@config/socialData.json";

const year = new Date().getFullYear();
const copyright = `© ${year} ${siteData.author.name}`;

// Social row (Figma 5:96, glyphs swapped to the pixel set). `name` is validated against the
// pixel-icon registry. Which platforms appear is this section's call; how one resolves is not.
type SocialLink = { name: PixelIconName; label: string; href: string; external?: boolean };
const socialLinks: readonly SocialLink[] = [
  { ...socialLink("github"), external: true },
  { ...socialLink("linkedin"), external: true },
  { name: "email", label: "Email", href: `mailto:${siteData.author.email}` },
];

// Legal row (Figma 5:103). Trailing slashes match astro.config `trailingSlash: "always"`.
const legalLinks = [
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms", href: "/terms/" },
] as const;
---

<footer class="bg-background border-border border-t-2" data-slot="site-footer">
  <div
    class="site-container flex flex-col items-center gap-4 py-4 text-center md:flex-row md:justify-between md:gap-6 md:text-left"
  >
    <p class="font-display text-info text-[9px] uppercase">{copyright}</p>

    <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-label={link.label}
              class="primary-focus text-foreground hover:text-info inline-flex items-center gap-2 text-sm font-semibold transition-colors"
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <PixelIcon name={link.name} class="h-4" />
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <nav aria-label="Legal">
      <ul class="flex items-center gap-4">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="primary-focus text-muted-foreground hover:text-info text-xs font-medium transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
