---
// src/components/Sections/Global/Header.astro — the global Paper Pixel site header.
//
// Cross-page chrome, rendered once in BaseLayout: a full-bleed paper bar with a forest pixel seam,
// restrained hard shadow, brand at left, and primary nav at right. Nav links keep their compact
// Press Start treatment and pointer. Below `lg` the nav collapses into a MENU button + Sheet drawer.
//
// Reuses existing pieces — ui/nav, ui/sheet (opened/closed via its `_dialog` data hooks), the pink
// `.pixel-btn` (global.css), and ui/theme-toggle. No new primitives. The MENU / CLOSE controls are
// worded (no icons). Identity is wired from portfolioData; links come from navData.
import HeaderNavLinks from "@components/Sections/Global/HeaderNavLinks.astro";
import { Nav } from "@components/ui/nav";
import { Sheet } from "@components/ui/sheet";
import { ThemeToggle } from "@components/ui/theme-toggle";
import portfolioData from "@config/portfolioData.json";
import headerAvatar from "@images/jsong-about-avatar.png";

const pathname = Astro.url.pathname;
const profileName = portfolioData.homeProfile.name;
---

<header
  class="bg-background border-border shadow-pixel sticky top-0 z-50 h-16 border-b-2"
  data-slot="site-header"
>
  {/* h-16 on the header (border-box) keeps the bar 64px total including its pixel seam. */}
  <div class="site-container flex h-full items-center justify-between">
    <!-- Brand: pixel avatar + wordmark, links home. The link's accessible name is the wordmark. On a
         narrow phone the brand (min-w-0) shrinks and the wordmark truncates before the row overflows. -->
    <a
      href="/"
      class="primary-focus flex min-w-0 items-center gap-3 sm:gap-4"
      aria-label={`${profileName} — home`}
    >
      <span
        class="bg-accent border-border flex size-9 shrink-0 items-center justify-center overflow-clip border-2 sm:size-10"
      >
        {
          /* Plain <img> on the Vite-fingerprinted import keeps this zero-JS. The source is a full
            transparent character scene, so the oversized crop keeps the face readable at 40px. */
        }
        <img
          src={headerAvatar.src}
          width={headerAvatar.width}
          height={headerAvatar.height}
          alt=""
          loading="eager"
          decoding="async"
          class="brand-avatar"
        />
      </span>
      <span
        class="font-display text-info xs:text-lg truncate text-base tracking-[-0.06em] uppercase sm:text-2xl"
      >
        {profileName}<span class="hidden sm:inline" aria-hidden="true">{" // "}Dev Log</span>
      </span>
    </a>

    <!-- Right cluster: desktop nav + theme toggle, or (below lg) toggle + hamburger. `shrink-0` so
         the controls keep their size and only the brand gives way on a cramped viewport. -->
    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <!-- `lg:contents` dissolves the wrapper on desktop so <Nav> flexes with its siblings; below lg
           the whole nav landmark is display:none (not just visually hidden). -->
      <div class="hidden lg:contents">
        <Nav aria-label="Primary" class="gap-6 xl:gap-8">
          <HeaderNavLinks pathname={pathname} />
        </Nav>
      </div>

      <ThemeToggle />

      {
        /* Mobile menu opener — the pink 8-bit button, worded "MENU" (no burger icon). `data-dialog-open`
          is the Sheet's own `_dialog` hook, so no SheetTrigger wrapper is needed. */
      }
      <button
        type="button"
        data-dialog-open="site-menu"
        aria-haspopup="dialog"
        aria-controls="site-menu"
        class="pixel-btn h-9 shrink-0 px-3 text-[10px] leading-none uppercase lg:hidden"
      >
        Menu
      </button>
    </div>
  </div>

  <!-- Mobile navigation drawer (native <dialog>). Opened by the MENU button above; `data-dialog-close`
       is the Sheet's own `_dialog` hook (Escape + backdrop dismiss are automatic). -->
  <Sheet id="site-menu" side="right" aria-labelledby="site-menu-title" class="w-72 gap-6">
    <div class="flex items-center justify-between">
      <span id="site-menu-title" class="font-display text-foreground text-sm uppercase">Menu</span>
      <button
        type="button"
        data-dialog-close
        class="pixel-btn h-9 shrink-0 px-3 text-[10px] leading-none uppercase"
      >
        Close
      </button>
    </div>

    <Nav orientation="vertical" aria-label="Primary" class="gap-2">
      <HeaderNavLinks pathname={pathname} fullWidth />
    </Nav>
  </Sheet>
</header>

<style>
  .brand-avatar {
    width: 210%;
    height: 210%;
    max-width: none;
    flex: none;
    object-fit: contain;
    transform: translateY(19%);
    image-rendering: pixelated;
  }
</style>
